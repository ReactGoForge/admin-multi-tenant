{
  "name": "web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "react-router build",
    "check": "pnpm run lint && pnpm run typecheck",
    "contracts:generate": "openapi-typescript ../service/docs/openapi/openapi.yaml -o app/services/generated/schema.d.ts",
    "dev": "react-router dev",
    "format": "eslint . --fix && pnpm run stylelint:fix",
    "lint": "eslint . && pnpm run stylelint",
    "lint:fix": "eslint . --fix && pnpm run stylelint:fix",
    "start": "react-router-serve ./build/server/index.js",
    "stylelint": "stylelint \"app/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"app/**/*.{css,scss}\" --fix",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@tanstack/react-query": "5.101.4",
    "antd": "^6.5.1",
    "axios": "^1.18.1",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "6.2.2",
    "react-router": "8.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "10.4.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "openapi-typescript": "7.13.0",
    "sass": "^1.101.0",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "8.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "4.1.10"
  }
}
