# 复制为 .env 后填写真实开发环境配置；.env 已被 Git 忽略，禁止提交密码和密钥。

# MySQL（Go 服务启动必需）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=admin_multi_tenant
MYSQL_USER=admin_multi_tenant
MYSQL_PASSWORD=

# Redis（启用验证码或登录限流时必需）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 登录认证
# development 会在 apps/service/logs 写入包含敏感文本的 HTTP JSONL，仅限本地排障。
APP_ENV=development
JWT_SECRET=
CAPTCHA_ENABLED=true
LOGIN_RATE_LIMIT_ENABLED=true
# 本地直连通常留空；反向代理环境填写逗号分隔的可信代理 IP 或 CIDR。
TRUSTED_PROXIES=

# 日志
SYSTEM_REQUEST_LOG_MODE=mutation_and_error
SYSTEM_EVENT_DB_ENABLED=true
SYSTEM_LOG_RETENTION_DAYS=30

# 微信小程序（缺省时不影响后台启动，小程序登录接口返回服务暂不可用）
WECHAT_MINIAPP_APP_SECRET=
WECHAT_MINIAPP_CODE_ENV_VERSION=develop

# MinIO 私有图片库（缺省时不影响后台启动，图片接口返回服务暂不可用）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=admin-multi-tenant-images
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=false
