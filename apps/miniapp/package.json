{
  "name": "miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "admin-multi-tenant",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "check": "pnpm run lint && pnpm run typecheck",
    "contracts:generate": "openapi-typescript ../service/docs/openapi/openapi.yaml -o src/api/generated/schema.d.ts",
    "format": "eslint . --fix && pnpm run stylelint:fix",
    "lint": "eslint . && pnpm run stylelint",
    "lint:fix": "eslint . --fix && pnpm run stylelint:fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:swan": "taro build --type swan --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:tt": "taro build --type tt --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:rn": "taro build --type rn --watch",
    "dev:qq": "taro build --type qq --watch",
    "dev:jd": "taro build --type jd --watch",
    "dev:harmony-hybrid": "taro build --type harmony-hybrid --watch"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@taroify/core": "1.0.1",
    "@taroify/icons": "1.0.1",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-alipay": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-harmony-hybrid": "4.2.0",
    "@tarojs/plugin-platform-jd": "4.2.0",
    "@tarojs/plugin-platform-qq": "4.2.0",
    "@tarojs/plugin-platform-swan": "4.2.0",
    "@tarojs/plugin-platform-tt": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.2.0",
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint-react/eslint-plugin": "5.18.0",
    "@tarojs/cli": "4.2.0",
    "@tarojs/plugin-generator": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/minimatch": "^5",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.2.0",
    "consola": "3.4.2",
    "eslint": "10.4.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "8.1.1",
    "tailwindcss": "4.3.3",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "vite-plugin-style-import": "2.0.0",
    "vitest": "0.34.6",
    "weapp-tailwindcss": "5.2.2"
  }
}
