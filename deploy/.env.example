# 该文件只作为服务器配置模板。真实配置建议保存到
# /opt/reactgoforge/admin-multi-tenant/shared/.env，
# 权限设置为 600，禁止提交到 Git。

# 发布
APP_DOMAIN=test.example.com
MEDIA_DOMAIN=media-test.example.com
GITHUB_REPOSITORY=git@github.com:ReactGoForge/admin-multi-tenant.git
GITHUB_DEPLOY_KEY=/opt/reactgoforge/admin-multi-tenant/shared/github_deploy
DEPLOY_BRANCH=main
# 产物发布目录；当前测试服务器使用以下固定路径。
SERVICE_RELEASE_ROOT=/opt/reactgoforge/admin-multi-tenant/shared/service-releases
WEB_RELEASE_ROOT=/opt/1panel/www/sites/admin-multi-tenant-test/web
OPENRESTY_PROXY_CONFIG=/opt/1panel/www/sites/admin-multi-tenant-test/proxy/root.conf

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=admin_multi_tenant
MYSQL_USER=admin_multi_tenant
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Redis
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# 登录认证
APP_ENV=production
JWT_SECRET=
CAPTCHA_ENABLED=true
LOGIN_RATE_LIMIT_ENABLED=true
# 只填写实际检查到的 1Panel OpenResty 代理 IP 或 CIDR；禁止填写 0.0.0.0/0。
TRUSTED_PROXIES=

# 日志
SYSTEM_REQUEST_LOG_MODE=mutation_and_error
SYSTEM_EVENT_DB_ENABLED=true
SYSTEM_LOG_RETENTION_DAYS=30

# 微信小程序
WECHAT_MINIAPP_APP_SECRET=
# 当前 1Panel 环境是开发测试服务器，固定生成体验版小程序码。
WECHAT_MINIAPP_CODE_ENV_VERSION=trial

# MinIO
# 当前测试环境由应用复用 MinIO 根凭证，下面两组值必须分别保持一致。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=media-test.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=admin-multi-tenant-images
MINIO_USE_SSL=false
MINIO_PUBLIC_USE_SSL=true
